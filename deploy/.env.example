# === Database ===
DB_USERNAME=rumoo
DB_PASSWORD=

# === Keycloak ===
# Public Keycloak base URL (OIDC endpoints) served through nginx. The trailing
# /auth is required because Keycloak runs with KC_HTTP_RELATIVE_PATH=/auth.
# Dev default: http://localhost:8080/auth (set by docker-compose.dev.yml)
KEYCLOAK_URL=
KEYCLOAK_REALM=Rumoo
KEYCLOAK_CLIENT_ID=rumoo-frontend
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_BACKEND_CLIENT_ID=rumoo-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=
# Required in production mode (behind reverse proxy) for correct OIDC issuer URLs.
# Example: http://localhost:8080/auth (dev) or https://rumoo.example.com/auth (prod)
KC_HOSTNAME=

# === Dev seed ===
# SEED_ENABLED=false starts the dev stack without populating the database or
# creating Keycloak users. SEED_PASSWORD is the dev password for the two seed
# realm users (default: Password123!).
SEED_ENABLED=true
SEED_PASSWORD=
